# Non-secret settings for a local AISOP run. Copy the lines you need into your shell or into .env (which is ignored by git).
# Never put real keys in this file.

# Database (PostgreSQL with the pgvector extension). Use your own credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5433/DATABASE

# API authentication: required in production. Tokens live in the database (analyst_api_clients).
API_AUTH_ENABLED=true
API_AUTH_ALLOW_LEGACY_KEYS=false
ENVIRONMENT=development

# Local language model (optional). Start Ollama first: set OLLAMA_MODELS to a folder on a drive with space, then `ollama serve`.
LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# MITRE ATT&CK Enterprise v20.1 (pinned by SHA-256 in code). Download the file to this path before starting.
ATTACK_REFERENCE_PATH=D:\AISOP-Reference-Data\MITRE-ATT&CK\Enterprise\v20.1\enterprise-attack-20.1.json

# Local threat intelligence feeds are read from data/feeds (Feodo Tracker CSV, Tor exit node list). Update them by
# downloading https://feodotracker.abuse.ch/downloads/ipblocklist.csv and https://check.torproject.org/torbulkexitlist

# External threat intelligence is OFF by default. To use AbuseIPDB: set all three, and every query still needs a per-query opt-in.
# TI_EXTERNAL_ENABLED=true
# TI_ENABLED_SOURCES=abuseipdb
# ABUSEIPDB_API_KEY=<your key, kept outside the repository>
