# ──────────────────────────────────────────────────────────────────
# AISOP — Environment Configuration
# Copy this file to .env and customise for your environment:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
APP_NAME=AISOP
ENVIRONMENT=development
DEBUG=true

# ── Database (PostgreSQL + pgvector — ADR-002) ───────────────────
# Recommended Docker Compose setup (host port 5433 -> container 5432):
DATABASE_URL=postgresql+psycopg://aisop:aisop@localhost:5433/aisop_dev
# Alternative: Native / Standard PostgreSQL (port 5432):
# DATABASE_URL=postgresql+psycopg://aisop:aisop@localhost:5432/aisop_dev
DATABASE_ECHO=false

# ── Ollama (Local LLM) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# ── Embeddings (pgvector — ADR-002) ──────────────────────────
EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL=nomic-embed-text

# ── Threat Intelligence API Keys ─────────────────────────────────
# Obtain keys from the respective platforms:
#   VirusTotal  → https://www.virustotal.com/gui/my-apikey
#   AbuseIPDB   → https://www.abuseipdb.com/account/api
#   AlienVault  → https://otx.alienvault.com/settings
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_PATH=logs/aisop.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
